# ==========================================
# Unity 6 & VR Project Gitignore Template
# Place at the root of your Unity project.
# ==========================================

# Unity 6 & General Cache/Temporary Files
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
.utmp/

# Memory Captures and Profiler Recordings
/[Mm]emoryCaptures/
/[Rr]ecordings/

# VR Platform & Build Specifics
# ------------------------------------------
# Android / Meta Quest build artifacts
.gradle/
/[Aa]ssets/Plugins/Android/assets/
# iOS / Vision Pro / OpenVR output directories
/[Bb]uildsXCode/
/XCodeBuild/

# Asset Store & Plugin Caches
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Crashlytics and Diagnostics
crashlytics-build.properties

# Visual Studio / Rider / VS Code cache directories
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for excluded assets
*.pidb.meta
*.pdb.meta
*.mdb.meta

# OS-specific files
.DS_Store
Thumbs.db

